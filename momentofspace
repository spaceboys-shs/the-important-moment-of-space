            optionsBox.innerHTML = q.options.map((opt, i) => `
                <button onclick="checkAnswer(${i})" class="quiz-opt-btn w-full p-3.5 rounded-xl bg-slate-800/80 hover:bg-slate-700 text-left text-sm text-slate-200 border border-slate-700 transition-all font-medium flex items-center gap-3">
                    <span class="w-6 h-6 rounded-lg bg-slate-900 border border-slate-700 flex items-center justify-center text-xs font-mono text-cyan-400">${String.fromCharCode(65 + i)}</span>
                    ${opt}
                </button>
            `).join('');
        }

        function checkAnswer(optIndex) {
            const q = quizQuestions[currentQuizIndex];
            const feedbackBox = document.getElementById('quiz-feedback');
            const nextBtn = document.getElementById('quiz-next-btn');
            const buttons = document.querySelectorAll('.quiz-opt-btn');

            buttons.forEach(btn => btn.disabled = true);

            if (optIndex === q.answer) {
                quizScore += 20;
                feedbackBox.className = "p-4 rounded-xl text-sm font-medium bg-emerald-950/80 border border-emerald-500/40 text-emerald-300";
                feedbackBox.innerHTML = "✨ Correct! Fantastic space knowledge!";
            } else {
                feedbackBox.className = "p-4 rounded-xl text-sm font-medium bg-rose-950/80 border border-rose-500/40 text-rose-300";
                feedbackBox.innerHTML = `❌ Incorrect. The correct answer was: <strong>${q.options[q.answer]}</strong>`;
            }

            document.getElementById('quiz-score').textContent = quizScore;
            feedbackBox.classList.remove('hidden');
            nextBtn.classList.remove('hidden');
        }

        document.getElementById('quiz-next-btn').addEventListener('click', () => {
            currentQuizIndex++;
            if (currentQuizIndex < quizQuestions.length) {
                renderQuizQuestion();
            } else {
                const quizCard = document.getElementById('quiz-card');
                quizCard.innerHTML = `
                    <div class="text-center py-8 space-y-4">
                        <div class="w-16 h-16 rounded-full bg-indigo-600/30 border border-indigo-400 flex items-center justify-center mx-auto text-amber-400">
                            <i data-lucide="trophy" class="w-8 h-8"></i>
                        </div>
                        <h3 class="text-2xl font-display font-bold text-white">Quiz Completed!</h3>
                        <p class="text-slate-300 text-sm">Your Final Cosmic Knowledge Score: <strong class="text-cyan-400 text-lg">${quizScore} / 100</strong></p>
                        <button onclick="restartQuiz()" class="px-6 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-medium text-sm transition-all inline-flex items-center gap-2">
                            <i data-lucide="rotate-ccw" class="w-4 h-4"></i>
                            Try Again
                        </button>
                    </div>
                `;
                lucide.createIcons();
            }
        });

        function restartQuiz() {
            currentQuizIndex = 0;
            quizScore = 0;
            location.reload();
        }

        function setupEventListeners() {
            // Search Input
            searchInput.addEventListener('input', (e) => {
                searchQuery = e.target.value.trim();
                renderMilestones();
            });

            // Layout Toggle
            viewTimelineBtn.addEventListener('click', () => {
                currentView = 'timeline';
                viewTimelineBtn.className = "px-3 py-1.5 rounded-lg text-xs font-medium flex items-center gap-1.5 bg-indigo-600 text-white transition-all";
                viewGridBtn.className = "px-3 py-1.5 rounded-lg text-xs font-medium flex items-center gap-1.5 text-slate-400 hover:text-white transition-all";
                renderMilestones();
            });

            viewGridBtn.addEventListener('click', () => {
                currentView = 'grid';
                viewGridBtn.className = "px-3 py-1.5 rounded-lg text-xs font-medium flex items-center gap-1.5 bg-indigo-600 text-white transition-all";
                viewTimelineBtn.className = "px-3 py-1.5 rounded-lg text-xs font-medium flex items-center gap-1.5 text-slate-400 hover:text-white transition-all";
                renderMilestones();
            });

            // Category Filter Pills
            categoryFilters.addEventListener('click', (e) => {
                const btn = e.target.closest('.filter-pill');
                if (!btn) return;

                document.querySelectorAll('.filter-pill').forEach(b => {
                    b.className = "filter-pill px-4 py-2 rounded-xl text-xs font-medium whitespace-nowrap bg-slate-800/80 text-slate-300 border border-slate-700 hover:border-slate-500 transition-all";
                });

                btn.className = "filter-pill px-4 py-2 rounded-xl text-xs font-medium whitespace-nowrap bg-indigo-600 text-white border border-indigo-500 shadow-md transition-all";
                currentFilter = btn.dataset.cat;
                renderMilestones();
            });

            // Modal Close Controls
            closeModalBtn.addEventListener('click', closeModal);
            modalCloseBottom.addEventListener('click', closeModal);
            detailModal.addEventListener('click', (e) => {
                if (e.target === detailModal) closeModal();
            });

            modalBookmarkBtn.addEventListener('click', () => {
                if (activeModalId) toggleFavorite(activeModalId);
            });

            // Mobile Menu Toggle
            const mobileBtn = document.getElementById('mobile-menu-btn');
            const mobileMenu = document.getElementById('mobile-menu');
            mobileBtn.addEventListener('click', () => {
                mobileMenu.classList.toggle('hidden');
            });

            // Ambient Sound Synthesizer
            const soundBtn = document.getElementById('sound-toggle');
            const soundIcon = document.getElementById('sound-icon');
            soundBtn.addEventListener('click', () => {
                if (!isAudioPlaying) {
                    startAmbientSound();
                    soundIcon.setAttribute('data-lucide', 'volume-2');
                    soundBtn.classList.add('border-indigo-500', 'text-indigo-400');
                    isAudioPlaying = true;
                } else {
                    stopAmbientSound();
                    soundIcon.setAttribute('data-lucide', 'volume-x');
                    soundBtn.classList.remove('border-indigo-500', 'text-indigo-400');
                    isAudioPlaying = false;
                }
                lucide.createIcons();
            });
        }

        function startAmbientSound() {
            try {
                audioCtx = new (window.AudioContext || window.webkitAudioContext)();
                ambientOsc = audioCtx.createOscillator();
                const gainNode = audioCtx.createGain();

                ambientOsc.type = 'sine';
                ambientOsc.frequency.setValueAtTime(55, audioCtx.currentTime); // Low deep space hum A1

                gainNode.gain.setValueAtTime(0.04, audioCtx.currentTime);
                ambientOsc.connect(gainNode);
                gainNode.connect(audioCtx.destination);
                ambientOsc.start();
            } catch (e) {
                console.log('Audio init failed', e);
            }
        }

        function stopAmbientSound() {
            if (ambientOsc) {
                ambientOsc.stop();
                ambientOsc.disconnect();
                ambientOsc = null;
            }
        }

        function initThreeJSBackground() {
            const canvas = document.getElementById('bg-canvas');
            const scene = new THREE.Scene();
            const camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 1000);
            camera.position.z = 12;

            const renderer = new THREE.WebGLRenderer({ canvas: canvas, alpha: true, antialias: true });
            renderer.setSize(window.innerWidth, window.innerHeight);
            renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

            // 1. STARFIELD PARTICLES
            const starsCount = 2000;
            const starGeometry = new THREE.BufferGeometry();
            const starPositions = new Float32Array(starsCount * 3);

            for (let i = 0; i < starsCount * 3; i += 3) {
                starPositions[i] = (Math.random() - 0.5) * 50;
                starPositions[i + 1] = (Math.random() - 0.5) * 50;
                starPositions[i + 2] = (Math.random() - 0.5) * 50;
            }

            starGeometry.setAttribute('position', new THREE.BufferAttribute(starPositions, 3));
            const starMaterial = new THREE.PointsMaterial({
                color: 0x93c5fd,
                size: 0.04,
                transparent: true,
                opacity: 0.85
            });
            const starField = new THREE.Points(starGeometry, starMaterial);
            scene.add(starField);

            // 2. GLOWING WIREFRAME PLANET / EARTH
            const earthGroup = new THREE.Group();
            const globeGeo = new THREE.IcosahedronGeometry(3.5, 3);
            const globeMat = new THREE.MeshBasicMaterial({
                color: 0x06b6d4,
                wireframe: true,
                transparent: true,
                opacity: 0.18
            });
            const globe = new THREE.Mesh(globeGeo, globeMat);
            earthGroup.add(globe);

            // Inner core glow
            const coreGeo = new THREE.SphereGeometry(3.2, 16, 16);
            const coreMat = new THREE.MeshBasicMaterial({
                color: 0x3b82f6,
                transparent: true,
                opacity: 0.05
            });
            const core = new THREE.Mesh(coreGeo, coreMat);
            earthGroup.add(core);

            earthGroup.position.set(5, -2, -2);
            scene.add(earthGroup);

            // 3. 3D SPACE STATION (ISS MODEL)
            const issGroup = new THREE.Group();

            // Central Module Body
            const bodyGeo = new THREE.CylinderGeometry(0.12, 0.12, 1.6, 12);
            const bodyMat = new THREE.MeshBasicMaterial({ color: 0xe2e8f0 });
            const centralBody = new THREE.Mesh(bodyGeo, bodyMat);
            centralBody.rotation.z = Math.PI / 2;
            issGroup.add(centralBody);

            // Solar Array Truss
            const trussGeo = new THREE.CylinderGeometry(0.04, 0.04, 3.2, 8);
            const trussMat = new THREE.MeshBasicMaterial({ color: 0x94a3b8 });
            const truss = new THREE.Mesh(trussGeo, trussMat);
            issGroup.add(truss);

            // Solar Panel Wings (Left & Right)
            const panelGeo = new THREE.BoxGeometry(0.8, 1.4, 0.02);
            const panelMat = new THREE.MeshBasicMaterial({ color: 0x0284c7, wireframe: true });

            const leftPanel1 = new THREE.Mesh(panelGeo, panelMat);
            leftPanel1.position.set(-1.2, 0, 0);
            issGroup.add(leftPanel1);

            const rightPanel1 = new THREE.Mesh(panelGeo, panelMat);
            rightPanel1.position.set(1.2, 0, 0);
            issGroup.add(rightPanel1);

            // Red/Cyan Thruster Light Beacon
            const beaconGeo = new THREE.SphereGeometry(0.08, 8, 8);
            const beaconMat = new THREE.MeshBasicMaterial({ color: 0x38bdf8 });
            const beacon = new THREE.Mesh(beaconGeo, beaconMat);
            beacon.position.set(0, 0.2, 0);
            issGroup.add(beacon);

            // Position & Scale ISS
            issGroup.scale.set(0.65, 0.65, 0.65);
            issGroup.position.set(-15, 4, 1);
            scene.add(issGroup);

            // 4. SHOOTING STARS / METEORS SYSTEM
            const meteorCount = 4;
            const meteors = [];

            for (let i = 0; i < meteorCount; i++) {
                const geometry = new THREE.BufferGeometry();
                const positions = new Float32Array(6); // 2 points (head and tail)

                geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
                const material = new THREE.LineBasicMaterial({
                    color: 0x38bdf8,
                    transparent: true,
                    opacity: 0.9,
                    linewidth: 2
                });

                const line = new THREE.Line(geometry, material);
                scene.add(line);

                meteors.push({
                    mesh: line,
                    x: (Math.random() - 0.5) * 30,
                    y: Math.random() * 15 + 5,
                    z: (Math.random() - 0.5) * 10,
                    speed: Math.random() * 0.25 + 0.15,
                    length: Math.random() * 1.5 + 1.0,
                    active: true
                });
            }

            function resetMeteor(m) {
                m.x = Math.random() * 20 - 5;
                m.y = Math.random() * 10 + 6;
                m.z = Math.random() * 10 - 5;
                m.speed = Math.random() * 0.22 + 0.12;
            }

            // Mouse Interactive Parallax
            let mouseX = 0;
            let mouseY = 0;
            window.addEventListener('mousemove', (e) => {
                mouseX = (e.clientX / window.innerWidth - 0.5) * 0.4;
                mouseY = (e.clientY / window.innerHeight - 0.5) * 0.4;
            });

            // Window Resize Handler
            window.addEventListener('resize', () => {
                camera.aspect = window.innerWidth / window.innerHeight;
                camera.updateProjectionMatrix();
                renderer.setSize(window.innerWidth, window.innerHeight);
            });

            // 5. ANIMATION LOOP
            let issProgress = 0;
            function animate() {
                requestAnimationFrame(animate);

                // Rotate Stars & Earth
                starField.rotation.y += 0.0002;
                earthGroup.rotation.y += 0.0015;
                earthGroup.rotation.x += 0.0005;

                // Animate Space Station Orbit Gliding Across Sky
                issProgress += 0.0025;
                if (issProgress > 1) issProgress = 0;

                // Smooth arc flight path across screen
                issGroup.position.x = -16 + issProgress * 32;
                issGroup.position.y = 4.5 + Math.sin(issProgress * Math.PI) * 1.8;
                issGroup.rotation.x += 0.004;
                issGroup.rotation.y += 0.006;
                issGroup.rotation.z = Math.sin(issProgress * 5) * 0.2;

                // Animate Shooting Stars / Meteors
                meteors.forEach(m => {
                    m.x -= m.speed * 1.2;
                    m.y -= m.speed * 0.8;

                    const positions = m.mesh.geometry.attributes.position.array;
                    // Head
                    positions[0] = m.x;
                    positions[1] = m.y;
                    positions[2] = m.z;
                    // Tail
                    positions[3] = m.x + m.length * 1.2;
                    positions[4] = m.y + m.length * 0.8;
                    positions[5] = m.z;

                    m.mesh.geometry.attributes.position.needsUpdate = true;

                    if (m.y < -12 || m.x < -20) {
                        resetMeteor(m);
                    }
                });

                // Camera mouse ease
                camera.position.x += (mouseX - camera.position.x) * 0.04;
                camera.position.y += (-mouseY - camera.position.y) * 0.04;

                renderer.render(scene, camera);
            }
            
            // Start Animation Loop on load
            animate();
        }
    </script>
</body>
