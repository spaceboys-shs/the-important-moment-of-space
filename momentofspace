    <style>
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #03050d;
        }
        ::-webkit-scrollbar-thumb {
            background: #1e293b;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #3b82f6;
        }
        
        .glass-panel {
            background: rgba(11, 15, 40, 0.7);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }
        
        .glass-card {
            background: rgba(15, 23, 42, 0.45);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.06);
            transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .glass-card:hover {
            background: rgba(30, 41, 59, 0.65);
            border-color: rgba(99, 102, 241, 0.45);
            transform: translateY(-4px);
            box-shadow: 0 14px 35px -10px rgba(99, 102, 241, 0.25);
        }

        .glow-text {
            text-shadow: 0 0 25px rgba(99, 102, 241, 0.7);
        }

        .glow-cyan {
            text-shadow: 0 0 20px rgba(6, 182, 212, 0.7);
        }

        /* Timeline Connector Line */
        .timeline-line::before {
            content: '';
            position: absolute;
            left: 50%;
            top: 0;
            bottom: 0;
            width: 2px;
            background: linear-gradient(180deg, #6366f1 0%, #06b6d4 50%, #ec4899 100%);
            transform: translateX(-50%);
            z-index: 0;
        }

        @media (max-width: 768px) {
            .timeline-line::before {
                left: 24px;
            }
        }

        /* Tech Scanlines Effect */
        .scanline-overlay {
            background: linear-gradient(
                to bottom,
                rgba(255,255,255,0),
                rgba(255,255,255,0) 50%,
                rgba(0, 0, 0, 0.25) 50%,
                rgba(0, 0, 0, 0.25)
            );
            background-size: 100% 4px;
            pointer-events: none;
        }
    </style>
</head>
